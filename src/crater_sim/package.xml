<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crater_sim</name>
  <version>0.1.0</version>
  <description>C.R.A.T.E.R lunar plain world, rover model, meteor environment and full-stack launch (Gazebo Harmonic + Nav2)</description>
  <maintainer email="sfeihiyoussef@gmail.com">Youssef Sfeihi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>navigation2</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>crater_perception</exec_depend>
  <exec_depend>crater_interfaces</exec_depend>
  <exec_depend>crater_dashboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
