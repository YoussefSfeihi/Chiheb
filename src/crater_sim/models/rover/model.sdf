<?xml version="1.0"?>
<!-- Sensor poses must stay in sync with the static TFs in
     launch/crater_sim.launch.py (SENSOR_TF). -->
<sdf version="1.8">
  <model name="crater_rover">
    <link name="base_link">
      <inertial><mass>20</mass><inertia><ixx>0.5</ixx><iyy>0.9</iyy><izz>1.1</izz></inertia></inertial>
      <collision name="chassis_collision"><geometry><box><size>0.8 0.5 0.2</size></box></geometry></collision>
      <visual name="chassis_visual">
        <geometry><box><size>0.8 0.5 0.2</size></box></geometry>
        <material><ambient>0.8 0.75 0.6 1</ambient><diffuse>0.85 0.8 0.65 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
      </visual>
      <visual name="solar_panel">
        <pose>-0.05 0 0.11 0 0 0</pose>
        <geometry><box><size>0.6 0.46 0.02</size></box></geometry>
        <material><ambient>0.05 0.05 0.2 1</ambient><diffuse>0.1 0.1 0.35 1</diffuse><specular>0.6 0.6 0.8 1</specular></material>
      </visual>
      <!-- Mast stops 8 cm below the camera so it never enters the camera's view. -->
      <visual name="mast">
        <pose>0.33 0 0.26 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.32</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
      </visual>

      <!-- Camera head (behind the lens, so it never enters the view). -->
      <visual name="camera_head">
        <pose>0.29 0 0.5 0 -0.2 0</pose>
        <geometry><box><size>0.1 0.16 0.07</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse><specular>0.5 0.5 0.5 1</specular></material>
      </visual>

      <!-- Headlight: the crater floor is in permanent shadow. -->
      <light name="headlight" type="spot">
        <pose>0.42 0 0.45 0 0.35 0</pose>
        <diffuse>0.9 0.9 0.85 1</diffuse><specular>0.3 0.3 0.3 1</specular>
        <attenuation><range>25</range><constant>0.3</constant><linear>0.02</linear><quadratic>0.002</quadratic></attenuation>
        <direction>1 0 0</direction>
        <spot><inner_angle>0.6</inner_angle><outer_angle>1.0</outer_angle><falloff>1.0</falloff></spot>
        <cast_shadows>false</cast_shadows>
      </light>

      <sensor name="lidar" type="gpu_lidar">
        <pose>0.3 0 0.35 0 0 0</pose>
        <topic>/scan</topic>
        <gz_frame_id>lidar</gz_frame_id>
        <update_rate>10</update_rate>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.45</min><max>15.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </lidar>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>

      <!-- RGB-D threat camera: wide FOV, tilted 11 deg UP to watch the sky for
           incoming meteors while still seeing the ground from ~1.5 m ahead. -->
      <sensor name="rgbd_camera" type="rgbd_camera">
        <pose>0.35 0 0.5 0 -0.2 0</pose>
        <topic>/camera</topic>
        <gz_frame_id>camera_optical</gz_frame_id>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.745</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>60</far></clip>
          <depth_camera><clip><near>0.1</near><far>60</far></clip></depth_camera>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
        </camera>
        <always_on>1</always_on>
      </sensor>


      <!-- TRAINING / EVALUATION ONLY: ground-truth box labeller with the exact pose and
           intrinsics of rgbd_camera. Auto-labels YOLO training images; the onboard detector
           never reads it. -->
      <sensor name="bbox_camera" type="boundingbox_camera">
        <pose>0.35 0 0.5 0 -0.2 0</pose>
        <topic>/camera/bbox</topic>
        <gz_frame_id>camera_optical</gz_frame_id>
        <update_rate>15</update_rate>
        <camera>
          <box_type>2d</box_type>
          <horizontal_fov>1.745</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>60</far></clip>
        </camera>
        <always_on>1</always_on>
      </sensor>

      <sensor name="imu" type="imu">
        <topic>/imu</topic>
        <gz_frame_id>base_link</gz_frame_id>
        <update_rate>50</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0005</bias_mean></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0005</bias_mean></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.0005</bias_mean></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <always_on>1</always_on>
      </sensor>
    </link>

    <link name="front_left_wheel">
      <pose>0.28 0.33 -0.08 -1.5707963 0 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.017</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel</child><axis><xyz>0 0 1</xyz></axis>
    </joint>
    <link name="rear_left_wheel">
      <pose>-0.28 0.33 -0.08 -1.5707963 0 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.017</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child><axis><xyz>0 0 1</xyz></axis>
    </joint>
    <link name="front_right_wheel">
      <pose>0.28 -0.33 -0.08 -1.5707963 0 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.017</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel</child><axis><xyz>0 0 1</xyz></axis>
    </joint>
    <link name="rear_right_wheel">
      <pose>-0.28 -0.33 -0.08 -1.5707963 0 0</pose>
      <inertial><mass>1.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.017</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <surface><friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child><axis><xyz>0 0 1</xyz></axis>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.66</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <!-- Raw wheel odometry: yaw is unreliable on a skid-steer (wheels slip when
           turning), so it is NOT published as TF. ekf_odom fuses its forward
           velocity with the IMU gyro and owns odom->base_link. -->
      <odom_topic>/wheel/odom</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <tf_topic>/wheel/tf_unused</tf_topic>
    </plugin>

    <!-- EVALUATION ONLY: perfect pose from the simulator. Never consumed by the
         onboard stack; used by tools/eval_*.py to score odometry & localization. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>crater_rover_truth</robot_base_frame>
      <odom_topic>/ground_truth/odom</odom_topic>
      <tf_topic>/ground_truth/tf_unused</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </model>
</sdf>
